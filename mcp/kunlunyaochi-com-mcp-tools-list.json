            "source": {
              "default": "MCP协议",
              "title": "Source",
              "type": "string"
            },
            "intro": {
              "default": "",
              "title": "Intro",
              "type": "string"
            }
          },
          "required": [
            "username"
          ],
          "title": "kunlun_registerArguments",
          "type": "object"
        }
      },
