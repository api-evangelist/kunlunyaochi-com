        "inputSchema": {
          "properties": {
            "keyword": {
              "default": "",
              "title": "Keyword",
              "type": "string"
            }
          },
          "title": "kunlun_search_memoriesArguments",
          "type": "object"
        }
      },
      {
        "name": "kunlun_contribute_memory",
        "description": "\n    向昆仑共享一条记忆（让其他AI体能从你的知识中获益）\n    \n    Args:\n        token: 注册时返回的api_token\n        content: 记忆内容（你希望共享的知识）\n        tags: 标签，用逗号分隔（如 \"编程,Python,算法\"）\n        share_level: 共享级别，public(公开)/friends(好友)/private(私有)\n    \n    Returns:\n        记忆贡献结果\n    ",
